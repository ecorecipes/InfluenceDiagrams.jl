{
  "type": "object",
  "properties": {
    "format": {
      "const": "ecorecipes.dve-certificate"
    },
    "version": {
      "const": 2
    },
    "provenance": {
      "type": "object",
      "properties": {
        "implementation_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_name": {
          "type": "string"
        },
        "exporter": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "runtime",
            "mathematical_fixture"
          ]
        },
        "exact_source": {
          "enum": [
            "none",
            "intrinsic_rational",
            "caller_companion",
            "checked_fixture"
          ]
        }
      },
      "required": [
        "implementation_manifest_sha256",
        "model_name",
        "exporter",
        "origin",
        "exact_source"
      ],
      "additionalProperties": false
    },
    "numeric": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "rational_exact",
            "binary64_exact"
          ]
        },
        "runtime_bits": {
          "type": "boolean"
        },
        "normalization": {
          "const": "none"
        }
      },
      "required": [
        "mode",
        "runtime_bits",
        "normalization"
      ],
      "additionalProperties": false
    },
    "runtime_tolerances": {
      "type": "object",
      "properties": {
        "kernel_normalization_f64": {
          "$ref": "#/$defs/binary64"
        },
        "decision_probability_f64": {
          "$ref": "#/$defs/binary64"
        }
      },
      "required": [
        "kernel_normalization_f64",
        "decision_probability_f64"
      ],
      "additionalProperties": false
    },
    "reference_pool": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reference": {
            "$ref": "#/$defs/reference"
          }
        },
        "required": [
          "code",
          "reference"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "variables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variable"
      },
      "minItems": 0
    },
    "topological_order": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_id"
      },
      "minItems": 0
    },
    "decision_order": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_id"
      },
      "minItems": 0
    },
    "mechanisms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mechanism"
      },
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      },
      "minItems": 0
    },
    "precedence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/source_id"
          },
          "earlier": {
            "$ref": "#/$defs/source_id"
          },
          "later": {
            "$ref": "#/$defs/source_id"
          }
        },
        "required": [
          "id",
          "earlier",
          "later"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "utilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/utility"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "object",
      "properties": {
        "hard": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "variable": {
                "$ref": "#/$defs/source_id"
              },
              "state_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "variable",
              "state_index"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "likelihood": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/table"
            }
          ]
        }
      },
      "required": [
        "hard",
        "likelihood"
      ],
      "additionalProperties": false
    },
    "solution": {
      "$ref": "#/$defs/solution"
    }
  },
  "required": [
    "format",
    "version",
    "provenance",
    "numeric",
    "runtime_tolerances",
    "reference_pool",
    "variables",
    "topological_order",
    "decision_order",
    "mechanisms",
    "decisions",
    "precedence",
    "utilities",
    "evidence",
    "solution"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ecorecipes:dve-certificate:2",
  "title": "Exact finite influence-DAG exporter certificate with the recorded DVE solution, version 2",
  "$defs": {
    "source_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 19
    },
    "binary64": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "rational": {
      "type": "object",
      "properties": {
        "num": {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "maxLength": 4096
        },
        "den": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 4096
        }
      },
      "required": [
        "num",
        "den"
      ],
      "additionalProperties": false
    },
    "scalar": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "q": {
              "$ref": "#/$defs/rational"
            }
          },
          "required": [
            "q"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "q": {
              "$ref": "#/$defs/rational"
            },
            "f64": {
              "$ref": "#/$defs/binary64"
            }
          },
          "required": [
            "q",
            "f64"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "f64": {
              "$ref": "#/$defs/binary64"
            }
          },
          "required": [
            "f64"
          ],
          "additionalProperties": false
        }
      ]
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "NamedRef"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "PointMassRef"
            },
            "state": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "PolicyRef"
            },
            "decision": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "decision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "NoRef"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "slot": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/source_id"
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "variable": {
          "$ref": "#/$defs/source_id"
        }
      },
      "required": [
        "id",
        "position",
        "variable"
      ],
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "properties": {
        "axes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          },
          "minItems": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "minItems": 0
              },
              "value": {
                "$ref": "#/$defs/scalar"
              }
            },
            "required": [
              "at",
              "value"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "axes",
        "entries"
      ],
      "additionalProperties": false
    },
    "variable": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/source_id"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "chance",
            "decision"
          ]
        },
        "space_ref": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/source_id"
              },
              "position": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "position",
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "space_ref",
        "states"
      ],
      "additionalProperties": false
    },
    "mechanism": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/source_id"
        },
        "name": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/source_id"
        },
        "kernel_ref": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          },
          "minItems": 0
        },
        "cpt": {
          "$ref": "#/$defs/table"
        },
        "factor": {
          "$ref": "#/$defs/table"
        }
      },
      "required": [
        "id",
        "name",
        "target",
        "kernel_ref",
        "parents",
        "cpt",
        "factor"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/source_id"
        },
        "name": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/source_id"
        },
        "information": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "name",
        "action",
        "information"
      ],
      "additionalProperties": false
    },
    "utility": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/source_id"
        },
        "name": {
          "type": "string"
        },
        "utility_ref": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          },
          "minItems": 0
        },
        "table": {
          "$ref": "#/$defs/table"
        }
      },
      "required": [
        "id",
        "name",
        "utility_ref",
        "inputs",
        "table"
      ],
      "additionalProperties": false
    },
    "solution_number": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "q": {
              "$ref": "#/$defs/rational"
            },
            "f64": {
              "$ref": "#/$defs/binary64"
            }
          },
          "required": [
            "q",
            "f64"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "f64": {
              "$ref": "#/$defs/binary64"
            }
          },
          "required": [
            "f64"
          ],
          "additionalProperties": false
        }
      ]
    },
    "policy": {
      "type": "object",
      "properties": {
        "decision": {
          "$ref": "#/$defs/source_id"
        },
        "action": {
          "$ref": "#/$defs/source_id"
        },
        "axes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          },
          "minItems": 0
        },
        "scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          },
          "minItems": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "minItems": 0
              },
              "action": {
                "$ref": "#/$defs/source_id"
              },
              "score": {
                "$ref": "#/$defs/solution_number"
              }
            },
            "required": [
              "at",
              "action",
              "score"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "decision",
        "action",
        "axes",
        "scope",
        "entries"
      ],
      "additionalProperties": false
    },
    "solution": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "object",
          "properties": {
            "name": {
              "const": "DecisionVariableElimination"
            },
            "order": {
              "type": "string"
            },
            "stable": {
              "type": "boolean"
            },
            "atol_f64": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/binary64"
                }
              ]
            },
            "constancy_atol_f64": {
              "$ref": "#/$defs/binary64"
            }
          },
          "required": [
            "name",
            "order",
            "stable",
            "atol_f64",
            "constancy_atol_f64"
          ],
          "additionalProperties": false
        },
        "arithmetic": {
          "enum": [
            "binary64",
            "exact_rational"
          ]
        },
        "data": {
          "enum": [
            "f64",
            "q"
          ]
        },
        "exact_fallback": {
          "type": "boolean"
        },
        "conditioned_on": {
          "const": "evidence.hard"
        },
        "julia_version": {
          "type": "string"
        },
        "elimination_order": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          },
          "minItems": 0
        },
        "value": {
          "$ref": "#/$defs/solution_number"
        },
        "policies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policy"
          },
          "minItems": 0
        }
      },
      "required": [
        "backend",
        "arithmetic",
        "data",
        "exact_fallback",
        "conditioned_on",
        "julia_version",
        "elimination_order",
        "value",
        "policies"
      ],
      "additionalProperties": false
    }
  }
}
